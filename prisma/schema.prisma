// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Field {
  fieldCode  String  @id
  fieldName  String
  location   String
  extendSize String
  fieldImage String
  crops      Crop[]
  staffs     Staff[]
}

model Crop {
  cropId    String @id
  cropName  String
  cropImage String
  category  String
  season    String
  fieldCode String
  field     Field  @relation(fields: [fieldCode], references: [fieldCode], onDelete: Cascade)
}

model Staff {
  staffId   String    @id
  firstName String
  lastName  String
  gender    String
  dob       DateTime
  contactNo Int
  email     String    @unique
  address   String
  role      String
  fieldCode String
  field     Field     @relation(fields: [fieldCode], references: [fieldCode], onDelete: Cascade)
  vehicles  Vehicle[]
}

model Vehicle {
  vehicleCode    String @id
  licensePlateNo String @unique
  category       String
  fuelType       String
  status         String
  remarks        String
  staffId        String
  staff          Staff  @relation(fields: [staffId], references: [staffId], onDelete: Cascade, onUpdate: Cascade)
}
